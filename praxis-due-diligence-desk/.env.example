# Copy to .env and fill in. Praxis runs end to end with NO keys and NO network:
# `fake` LLM provider + `fake` (hashing) embedder + in-memory vector store.

# --- LLM ---
# provider: fake | openai | anthropic | nebius
PRAXIS_LLM_PROVIDER=openai
# model tiers. openai/anthropic use "<provider>:<model>"; nebius uses a bare model id.
# strong = planner + bull/bear analysts; fast = editor + red_team.
PRAXIS_STRONG_MODEL=openai:gpt-4o
PRAXIS_FAST_MODEL=openai:gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=

# --- Retrieval / RAG ---
# provider: fake | openai | nebius
PRAXIS_EMBEDDING_PROVIDER=openai
PRAXIS_EMBEDDING_MODEL=text-embedding-3-large
# text-embedding-3-* are Matryoshka — this is the dimension we ask OpenAI to
# return (and the Qdrant vector size). 1536 is a good quality/size tradeoff.
PRAXIS_EMBEDDING_DIM=1536
# empty -> in-memory Qdrant; set to run against a server (docker compose provides one)
PRAXIS_QDRANT_URL=
PRAXIS_QDRANT_COLLECTION=praxis_corpus
PRAXIS_CHUNK_SIZE=900
PRAXIS_CHUNK_OVERLAP=150
PRAXIS_CONTEXTUAL_CHUNKS=false
PRAXIS_RETRIEVAL_K=6
# reranker: lexical | cross-encoder | none   (cross-encoder needs: uv sync --extra rerank)
PRAXIS_RERANKER=lexical

# --- Graph behaviour ---
PRAXIS_MAX_GAP_LOOPS=1
PRAXIS_RESEARCH_CONCURRENCY=4

# --- Persistence ---
# empty -> sqlite+aiosqlite:///./praxis.db (dev/CI). Postgres + Alembic migrations
# land in Phase 5 alongside the rest of the deploy story.
PRAXIS_DATABASE_URL=
# the LangGraph checkpointer's own SQLite file (kept separate from the DB above
# so the two libraries never write to the same file).
PRAXIS_CHECKPOINT_DB_PATH=./praxis_checkpoints.db

# --- Observability (Phase 4) ---
PRAXIS_OTEL_ENABLED=false

# --- Phase 3+ (not used yet) ---
# EXA_API_KEY=
