# Copy to .env and fill in. Praxis runs with NO keys in `fake` provider mode.

# LLM provider: fake | openai | anthropic   (nebius wiring lands in Phase 1)
PRAXIS_LLM_PROVIDER=fake

# Model tiers (used when provider != fake). Format: "<provider>:<model>".
PRAXIS_STRONG_MODEL=openai:gpt-4o
PRAXIS_FAST_MODEL=openai:gpt-4o-mini

# Provider keys (only the one matching PRAXIS_LLM_PROVIDER is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=

# Graph behaviour
PRAXIS_MAX_GAP_LOOPS=1

# Observability (Phase 4)
PRAXIS_OTEL_ENABLED=false

# --- Phase 1+ (not used yet) ---
# QDRANT_URL=http://localhost:6333
# DATABASE_URL=postgresql+psycopg://praxis:praxis@localhost:5432/praxis
# EXA_API_KEY=
