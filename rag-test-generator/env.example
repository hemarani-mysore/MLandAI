# ─────────────────────────────────────────────
# RAG Test Generator — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# GitHub Personal Access Token
# Generate at: github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=your-github-token-here

# GitHub username (for pushing generated tests)
GITHUB_USERNAME=your-github-username-here

# OpenAI API — used for generation + embeddings across the whole project
# Get one at platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB settings
CHROMA_DB_PATH=./outputs/chroma_db

# Output directory for generated tests
OUTPUT_DIR=./outputs/generated_tests

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
